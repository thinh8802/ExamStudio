# ========================================================
# EXAMPREP STUDIO ENVIRONMENT CONFIGURATION (TEMPLATE)
# ========================================================
# HƯỚNG DẪN DÀNH CHO DEVELOPER:
# 1. Tạo file .env cục bộ (file này đã được .gitignore chặn, không commit lên GitHub).
# 2. GH_TOKEN chỉ cần thiết khi bạn muốn tự động publish Release lên GitHub bằng lệnh CLI.
# 3. VITE_SUPABASE_URL và VITE_SUPABASE_ANON_KEY dùng cho Client app xác thực mã online 1 lần.
# 4. SUPABASE_SERVICE_ROLE_KEY chỉ dùng cho Developer Tool (CLI tạo mã).
# ========================================================

# GitHub Personal Access Token (repo scope) dùng để publish release
GH_TOKEN=

# Supabase Cloud Database (Free Tier) - Xác thực bản quyền 1-Lần
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Chỉ dùng riêng cho Admin / Developer CLI tạo key)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
