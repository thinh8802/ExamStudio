{
  "name": "examprep-studio",
  "private": true,
  "version": "3.3.0",
  "description": "ExamPrep Studio - Nền tảng Ôn luyện thi & Quản lý Học tập Thông minh",
  "author": {
    "name": "ExamPrep Studio",
    "email": "daothinh636@gmail.com"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "release": "node scripts/release-cli.cjs",
    "build:exe": "npm run build && electron-builder --win && node scripts/organize-release.cjs",
    "organize:release": "node scripts/organize-release.cjs",
    "build:installer": "npm run build && electron-builder --win nsis",
    "license:generate-keys": "node ../developer_tools/license-cli.cjs generate-keys",
    "license:issue": "node ../developer_tools/license-cli.cjs issue",
    "license:verify": "node ../developer_tools/license-cli.cjs verify"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.9.0",
    "papaparse": "^5.5.2",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.2.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.1",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.examprepstudio.desktop",
    "productName": "ExamPrep Studio",
    "copyright": "Copyright © 2026 ExamPrep Studio",
    "directories": {
      "output": "../release"
    },
    "publish": {
      "provider": "github",
      "owner": "thinh8802",
      "repo": "ExampStudio"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "certificateFile": "../developer_tools/keys/examprep_codesign.pfx",
        "certificatePassword": "ExamPrepStudio@2026"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "ExamPrepStudio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ExamPrep Studio",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "artifactName": "ExamPrepStudio-Setup-v${version}.${ext}",
      "differentialPackage": true,
      "include": "build/installer.nsh"
    }
  }
}
